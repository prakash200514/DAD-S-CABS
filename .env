# ====================================================================
# DAD'S AUTO & CAB — ENVIRONMENT CONFIGURATION
# Tagline: "Safe Rides • Local Routes • Always With You"
# Service Area: TAMIL NADU ONLY (Version 1)
# ====================================================================

# Google Maps API Key (Optional for development; if not set, the app
# runs the built-in high-precision Tamil Nadu Vector Map Engine automatically)
VITE_GOOGLE_MAPS_API_KEY=

# Backend API Endpoint (defaults to local development server)
VITE_API_URL=http://localhost:4000/api

# Backend Server Port
PORT=4000
NODE_ENV=development

# PostgreSQL Connection String (Prisma ORM)
DATABASE_URL="postgresql://postgres:password@localhost:5432/dads_cab_db?schema=public"

# Authentication Secret
JWT_SECRET=dads_auto_cab_super_secure_key_tamilnadu_2026
